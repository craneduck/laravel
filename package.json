{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format:check": "biome format resources/ ; prettier resources/**/*.blade.php --check",
        "format": "biome format resources/ --write ; prettier resources/**/*.blade.php --write",
        "lint": "biome lint ./resources",
        "types": "tsc --noEmit"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.2",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "concurrently": "^10.0.3",
        "prettier": "3.9.5",
        "prettier-plugin-blade": "^3.0.0",
        "prettier-plugin-tailwindcss": "^0.8.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react": "^6.0.5",
        "laravel-vite-plugin": "^3.2",
        "lucide-react": "^1.31.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.0",
        "vite": "^8.0.0",
        "vite-plugin-watch": "^0.3.1"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
