{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!vendor",
      "!!public",
      "!!storage",
      "!resources/js/actions",
      "!resources/js/routes",
      "!resources/js/wayfinder"
    ]
  },
  "formatter": {
    "enabled": true,
    "includes": [
      "**",
      "!resources/js/types/generated.d.ts"
    ],
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedProperties": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":BUN:",
                ":NODE:"
              ],
              ":BLANK_LINE:",
              [
                ":PACKAGE:"
              ],
              ":BLANK_LINE:",
              [
                ":ALIAS:",
                ":PATH:"
              ]
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single"
    },
    "linter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "expand": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "composer.json",
        "package.json",
        "pint.json",
        "lang/**/*.json"
      ],
      "formatter": {
        "indentWidth": 4
      }
    }
  ]
}
